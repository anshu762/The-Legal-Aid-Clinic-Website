# ==========================================
# TLC LEGAL AID CLINIC - ENVIRONMENT VARIABLES
# ==========================================

# 1. DATABASE CONFIGURATION (NEON POSTGRES)
# ------------------------------------------
# DATABASE_URL: The connection string used by Prisma Client (Application logic).
# Important: If using Neon, append ?pgbouncer=true for connection pooling in serverless environments.
DATABASE_URL="postgres://user:password@ep-example-pooler.region.aws.neon.tech/neondb?pgbouncer=true"

# DIRECT_URL: The direct connection string used by Prisma CLI for migrations (npx prisma db push).
# Important: This should NOT use the pgbouncer pooler.
DIRECT_URL="postgres://user:password@ep-example.region.aws.neon.tech/neondb"


# 2. NEXTAUTH CONFIGURATION
# ------------------------------------------
# NEXTAUTH_URL: The canonical URL of your deployed application.
# Must be set in production to your actual domain (e.g. https://www.yourclinic.org).
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET: A random 32+ character string used to encrypt session cookies.
# Generate one securely using: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-secure-secret-here"


# 3. EMAIL (TRANSACTIONAL NOTIFICATIONS)
# ------------------------------------------
# Configured for Resend (or any standard SMTP provider).
# If omitted, the app gracefully falls back to console.log() for testing.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASSWORD="re_your_api_key_here"
SMTP_FROM="The Legal Aid Clinic <noreply@yourdomain.org>"


# 4. STORAGE / FILE UPLOADS (Local Filesystem for MVP)
# ------------------------------------------
# Currently, uploads are securely stored in the local /uploads directory.
# Ensure your host provides persistent storage. If moving to S3, add those variables here later.

# Admin Seed Info
ADMIN_EMAIL="admin@tlc.org"
ADMIN_PASSWORD="secure_admin_password"
